{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@blue-patterns/core/*": ["../../packages/core/src/*"],
      "@blue-patterns/core": ["../../packages/core/src"],
      "@blue-patterns/motion/*": ["../../packages/motion/src/*"],
      "@blue-patterns/motion": ["../../packages/motion/src"],
      "@blue-patterns/charts/*": ["../../packages/charts/src/*"],
      "@blue-patterns/charts": ["../../packages/charts/src"],
      "@blue-patterns/themes/*": ["../../packages/themes/*"],
      "@blue-patterns/themes": ["../../packages/themes"],
      "@blue-patterns/mcp/*": ["../../packages/mcp/src/*"],
      "@blue-patterns/mcp": ["../../packages/mcp/src"]
    }
  },
  "include": ["src", "registry"]
}
